# Google Analytics 4 — ID de medição (ex.: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Google Tag Manager — ID do contêiner (ex.: GTM-XXXXXXX)
VITE_GTM_ID=

# Meta (Facebook) Pixel — ID do pixel
VITE_META_PIXEL_ID=

# Google Place ID do negócio (usado no JSON-LD SEO)
VITE_GOOGLE_PLACE_ID=

# Google Business Profile (Google Meu Negócio) — CID / ID do perfil
VITE_GOOGLE_BUSINESS_PROFILE_ID=
